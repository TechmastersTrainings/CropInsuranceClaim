# ==========================================
# CROP INSURANCE SYSTEM CONFIGURATION
# ==========================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change_me_to_a_secure_random_64_char_string_for_production
ALLOWED_HOSTS=localhost,127.0.0.1

# API & Frontend URLs
API_BASE_URL=http://localhost:8000/api/v1
FRONTEND_URL=http://localhost:5173

# Database Connection (PostgreSQL)
DB_ENGINE=postgresql
DB_NAME=crop_insurance_db
DB_USER=crop_user
DB_PASSWORD=crop_password_secure
DB_HOST=localhost
DB_PORT=5432
# Development SQLite Fallback if DB_ENGINE=sqlite
SQLITE_DB_PATH=./backend/app.db

# JWT Security
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# IoT Telemetry Ingestion
IOT_MQTT_BROKER=localhost
IOT_MQTT_PORT=1883
IOT_INGEST_API_KEY=dev_iot_insecure_key_rotate_in_prod

# Blockchain (Hyperledger Fabric)
FABRIC_NETWORK_PROFILE=./blockchain/fabric-network/connection-profile.json
FABRIC_CHANNEL_NAME=cropinsurancechannel
FABRIC_CHAINCODE_NAME=claimlifecycle
FABRIC_MSP_ID=Org1MSP

# External Data Providers (Weather & Remote Sensing)
WEATHER_API_PROVIDER=open-meteo
WEATHER_API_KEY=optional_external_provider_key
SATELLITE_PROVIDER_ENABLED=False
